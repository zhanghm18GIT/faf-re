cmake_minimum_required(VERSION 3.25)
project(render_source_probe LANGUAGES CXX)
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
  message(FATAL_ERROR "Native clang-cl probe required")
endif()
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
add_executable(render_source_probe probe.cpp)
# The mock's assertions must remain active in this separate Release executable.
target_compile_options(render_source_probe PRIVATE /UNDEBUG /EHsc)
enable_testing()
add_test(NAME render_source_probe COMMAND render_source_probe)
set_tests_properties(render_source_probe PROPERTIES TIMEOUT 30)

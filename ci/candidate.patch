diff --git a/tests/image_codec/TextureQualityTests.cpp b/tests/image_codec/TextureQualityTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2543600f79792fc320a22212746f24a004b6f14
--- /dev/null
+++ b/tests/image_codec/TextureQualityTests.cpp
@@ -0,0 +1,84 @@
+// Engine addition: the original's texture-quality mip skip applies to 2D DDS,
+// not to cubes or volumes. This topology check needs no graphics device.
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include "gpg/gal/backends/common/TextureQuality.h"
+
+namespace
+{
+  int gFailures = 0;
+
+  void Check(const bool condition, const char* const what)
+  {
+    if (!condition) {
+      std::printf("FAIL: %s\n", what);
+      ++gFailures;
+    }
+  }
+
+  void Put(std::uint8_t* const data, const std::size_t offset, const std::uint32_t value)
+  {
+    std::memcpy(data + offset, &value, sizeof(value));
+  }
+
+  void TestTopology(const std::uint32_t skip)
+  {
+    // Deliberately unaligned: DDS files need no word alignment.
+    std::array<std::uint8_t, 150U> storage{};
+    std::uint8_t* const data = storage.data() + 1U;
+    Put(data, 0U, 0x20534444U);
+    Put(data, 4U, 124U);
+    Put(data, 76U, 32U);
+    Put(data, 80U, 0x4U);
+    Put(data, 84U, 0x31545844U);
+    const auto effective = [&](const std::size_t bytes = 148U) {
+      return gpg::gal::imaging::TextureQualityMipLevels(data, bytes, skip);
+    };
+
+    Check(gpg::gal::imaging::TextureQualityMipLevels(nullptr, 0U, skip) == skip, "null input");
+    for (std::size_t bytes = 0U; bytes < 128U; ++bytes) {
+      Check(effective(bytes) == skip, "short legacy header");
+    }
+    Check(effective() == skip, "ordinary 2D preserves quality");
+    for (const std::uint32_t caps : {0x200U, 0xFE00U, 0x200000U, 0x200200U}) {
+      Put(data, 112U, caps);
+      Check(effective() == 0U, "legacy cube or volume retains top mip");
+    }
+    Put(data, 112U, 0U);
+    Put(data, 84U, 0x30315844U);
+    for (const std::uint32_t dimension : {3U, 4U}) {
+      for (const std::uint32_t misc : {0U, 4U}) {
+        for (const std::uint32_t legacyCaps : {0U, 0x200U, 0x200000U}) {
+          Put(data, 112U, legacyCaps);
+          Put(data, 132U, dimension);
+          Put(data, 136U, misc);
+          Put(data, 140U, 3U); // arrays do not themselves suppress 2D quality
+          Check(effective() == (dimension == 4U || misc == 4U ? 0U : skip), "DX10 topology supersedes legacy caps");
+        }
+      }
+    }
+    Put(data, 112U, 0U);
+    for (std::size_t bytes = 128U; bytes < 148U; ++bytes) {
+      Check(effective(bytes) == skip, "short DX10 extension");
+    }
+    Put(data, 80U, 0x41U); // RGB: the unused FourCC slot must not enable DX10
+    Check(effective() == skip, "RGB ignores unused FourCC slot");
+    Put(data, 112U, 0x200U);
+    Check(effective() == 0U, "RGB cube retains top mip");
+    Put(data, 0U, 0U);
+    Check(effective() == skip, "non-DDS input preserves quality");
+  }
+} // namespace
+
+int main()
+{
+  for (std::uint32_t skip = 0U; skip < 32U; ++skip) {
+    TestTopology(skip);
+  }
+  std::printf("%d failed\n", gFailures);
+  return gFailures == 0 ? 0 : 1;
+}
diff --git a/tests/memory/LuaArenaLargeRunTests.cpp b/tests/memory/LuaArenaLargeRunTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ea16ab6a1041c9d8900c14361669a098afed26fa
--- /dev/null
+++ b/tests/memory/LuaArenaLargeRunTests.cpp
@@ -0,0 +1,163 @@
+// Standalone x64 allocator tests; no game data or renderer required.
+// Compile from the repository root:
+// g++ -std=c++20 -O2 -pthread -Isrc tests/memory/LuaArenaLargeRunTests.cpp -o /tmp/lua-arena-tests
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <new>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+#include "../../src/lua/LuaArena.cpp"
+
+namespace
+{
+  bool failNew = false;
+
+  void Check(const bool condition)
+  {
+    if (!condition) {
+      std::fputs("Lua arena regression failed\n", stderr);
+      std::abort();
+    }
+  }
+
+  std::vector<void*> FillArena()
+  {
+    std::vector<void*> blocks;
+    while (void* const block = lua::ArenaAllocate(16385)) {
+      blocks.push_back(block);
+    }
+    Check(blocks.size() == gReserveBytes / kSpanBytes);
+    return blocks;
+  }
+
+  void FullCapacity()
+  {
+    const auto blocks = FillArena();
+    for (std::size_t index = 0; index < blocks.size(); index += 2) {
+      lua::ArenaFree(blocks[index]);
+    }
+    for (std::size_t index = 1; index < blocks.size(); index += 2) {
+      lua::ArenaFree(blocks[index]);
+    }
+    void* const all = lua::ArenaAllocate(gReserveBytes);
+    Check(all != nullptr && reinterpret_cast<std::uintptr_t>(all) == gBase);
+    Check(lua::ArenaAllocate(16385) == nullptr);
+    lua::ArenaFree(all);
+    Check(lua::ArenaAllocate(gReserveBytes) != nullptr);
+    std::puts("Full arena joins adjacent runs and reuses the entire range");
+  }
+
+  void FailedRequestOrder()
+  {
+    const auto blocks = FillArena();
+    for (std::size_t index = blocks.size(); index-- > 0;) {
+      if (index % 2 != 0) {
+        lua::ArenaFree(blocks[index]);
+      }
+    }
+    const auto start = std::chrono::steady_clock::now();
+    for (int attempt = 0; attempt < 1000; ++attempt) {
+      Check(lua::ArenaAllocate(kSpanBytes + 1) == nullptr);
+    }
+    const auto milliseconds =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    Check(lua::ArenaAllocate(16385) == blocks.back());
+    std::printf("1000 failed requests preserve next allocation; %.3f ms\n", milliseconds);
+  }
+
+  void HostHeapFailure()
+  {
+    // No harness allocations after failNew. Reserving virtual space does not populate it.
+    static void* blocks[kSpanCount];
+    lua::ArenaReserve();
+    failNew = true;
+    std::size_t count = 0;
+    while (count < kSpanCount && (blocks[count] = lua::ArenaAllocate(16385)) != nullptr) {
+      ++count;
+    }
+    for (std::size_t index = 0; index < count; ++index) {
+      lua::ArenaFree(blocks[index]);
+    }
+    void* const all = lua::ArenaAllocate(count * kSpanBytes);
+    Check(all != nullptr);
+    lua::ArenaFree(all);
+    failNew = false;
+    std::puts("Large allocation, free and adjacent-run reuse work with host new disabled");
+  }
+
+  void Oversize()
+  {
+    void* const block = lua::ArenaAllocate(50000);
+    Check(block != nullptr);
+    std::memset(block, 42, 50000);
+    Check(lua::ArenaAllocate(std::numeric_limits<std::size_t>::max()) == nullptr);
+    Check(lua::ArenaReallocate(block, 50000, std::numeric_limits<std::size_t>::max()) == nullptr);
+    Check(static_cast<unsigned char*>(block)[49999] == 42);
+    lua::ArenaFree(block);
+    std::puts("Oversize requests fail without losing the old allocation");
+  }
+
+  void CrossThreadFree()
+  {
+    std::vector<void*> blocks(4096);
+    for (void*& block : blocks) {
+      block = lua::ArenaAllocate(65537);
+      Check(block != nullptr);
+      std::memset(block, 0x5a, 65537);
+    }
+    std::vector<std::thread> workers;
+    for (std::size_t worker = 0; worker < 8; ++worker) {
+      workers.emplace_back([&, worker] {
+        for (std::size_t index = worker; index < blocks.size(); index += 8) {
+          Check(static_cast<unsigned char*>(blocks[index])[65536] == 0x5a);
+          lua::ArenaFree(blocks[index]);
+          for (int iteration = 0; iteration < 100; ++iteration) {
+            void* const block = lua::ArenaAllocate(20001);
+            Check(block != nullptr);
+            std::memset(block, 1, 20001);
+            lua::ArenaFree(block);
+          }
+        }
+      });
+    }
+    for (auto& worker : workers) {
+      worker.join();
+    }
+    std::puts("Cross-thread free and 409600 allocate/free pairs pass");
+  }
+} // namespace
+
+void* operator new(const std::size_t bytes)
+{
+  if (!failNew) {
+    if (void* const allocation = std::malloc(bytes != 0 ? bytes : 1)) {
+      return allocation;
+    }
+  }
+  throw std::bad_alloc{};
+}
+
+void operator delete(void* const block) noexcept { std::free(block); }
+void operator delete(void* const block, std::size_t) noexcept { std::free(block); }
+
+int main(const int argc, char** const argv)
+{
+  std::set_terminate([] { std::fputs("Unexpected termination\n", stderr); std::_Exit(42); });
+  if (argc != 2) {
+    std::fputs("Expected: capacity | failed-order | host-oom | oversized | threads\n", stderr);
+    return 2;
+  }
+  const std::string_view mode(argv[1]);
+  if (mode == "capacity") FullCapacity();
+  else if (mode == "failed-order") FailedRequestOrder();
+  else if (mode == "host-oom") HostHeapFailure();
+  else if (mode == "oversized") Oversize();
+  else if (mode == "threads") CrossThreadFree();
+  else return 2;
+}
diff --git a/tests/memory/LuaArenaPressureTests.cpp b/tests/memory/LuaArenaPressureTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..94604a61558f98ffcc8150aa3e7694e46a38d318
--- /dev/null
+++ b/tests/memory/LuaArenaPressureTests.cpp
@@ -0,0 +1,135 @@
+// Standalone x64 allocator test. From the repository root:
+// g++ -std=c++20 -O2 -pthread -Isrc tests/memory/LuaArenaPressureTests.cpp -o lua-arena-pressure
+// Compile this file alone: it includes the implementation to check internal invariants.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+#if INTPTR_MAX == INT32_MAX
+#error This test requires the x64 Lua arena implementation.
+#endif
+
+#include "../../src/lua/LuaArena.cpp"
+
+namespace
+{
+  constexpr std::size_t kTestSpans = 257;
+  constexpr std::size_t kOperations = 100000;
+
+  struct LiveAllocation
+  {
+    void* pointer;
+    std::size_t spans;
+    unsigned char tag;
+  };
+
+  void Require(const bool condition, const char* const message)
+  {
+    if (!condition) {
+      std::fprintf(stderr, "%s\n", message);
+      std::abort();
+    }
+  }
+
+  std::size_t FirstSpan(const void* const pointer)
+  {
+    return (reinterpret_cast<std::uintptr_t>(pointer) - gBase) / kSpanBytes;
+  }
+
+  void CheckFreeRuns(const bool (&used)[kTestSpans])
+  {
+    bool free[kTestSpans]{};
+    Require(gFreeRunCount <= kTestSpans, "Free-run count exceeds capacity");
+    for (std::size_t index = 0; index < gFreeRunCount; ++index) {
+      const LargeRun run = gFreeRuns[index];
+      Require(run.spans > 0 && run.firstSpan < kTestSpans && run.spans <= kTestSpans - run.firstSpan,
+              "Free run is empty or out of bounds");
+      for (std::size_t offset = 0; offset < run.spans; ++offset) {
+        const std::size_t span = run.firstSpan + offset;
+        Require(!used[span] && !free[span], "Free runs overlap each other or a live allocation");
+        free[span] = true;
+      }
+    }
+    for (std::size_t span = 0; span < kTestSpans; ++span) {
+      Require(free[span] != used[span], "Free-list coverage differs from the occupancy map");
+    }
+  }
+}
+
+int main()
+{
+  lua::ArenaReserve();
+  Require(gReserveBytes >= kTestSpans * kSpanBytes, "Reserved arena is too small for this test");
+  // Restrict usable capacity without changing the OS reservation. This forces frequent
+  // pressure recovery cheaply; it does not test the OS reservation fallback branches.
+  // Run in a fresh standalone process. These internal-state checks and this capacity
+  // override must not run alongside other threads or other users of the arena.
+  gReserveBytes = kTestSpans * kSpanBytes;
+
+  std::vector<LiveAllocation> live;
+  bool used[kTestSpans]{};
+  std::mt19937 random(39148);
+  for (std::size_t span = 0; span < kTestSpans; ++span) {
+    void* const pointer = lua::ArenaAllocate(kSpanBytes);
+    Require(pointer != nullptr && FirstSpan(pointer) == span, "Initial fill failed");
+    std::memset(pointer, 17, kSpanBytes);
+    live.push_back({pointer, 1, 17});
+    used[span] = true;
+  }
+
+  for (std::size_t step = 0; step < kOperations; ++step) {
+    if (!live.empty() && random() % 2 != 0) {
+      const std::size_t index = random() % live.size();
+      const LiveAllocation allocation = live[index];
+      const std::size_t first = FirstSpan(allocation.pointer);
+      for (std::size_t offset = 0; offset < allocation.spans; ++offset) {
+        Require(used[first + offset], "Live allocation missing from occupancy map");
+        Require(static_cast<unsigned char*>(allocation.pointer)[offset * kSpanBytes] == allocation.tag,
+                "Live payload was overwritten");
+        used[first + offset] = false;
+      }
+      lua::ArenaFree(allocation.pointer);
+      live[index] = live.back();
+      live.pop_back();
+    } else {
+      const std::size_t spans = 1 + random() % 70;
+      std::size_t consecutive = 0;
+      bool possible = false;
+      for (const bool occupied : used) {
+        consecutive = occupied ? 0 : consecutive + 1;
+        if (consecutive >= spans) {
+          possible = true;
+        }
+      }
+      void* const pointer = lua::ArenaAllocate(spans * kSpanBytes);
+      Require((pointer != nullptr) == possible, "Allocation disagrees with contiguous free-space oracle");
+      if (pointer != nullptr) {
+        const std::size_t first = FirstSpan(pointer);
+        Require(first < kTestSpans && spans <= kTestSpans - first, "Allocation exceeds test capacity");
+        const auto tag = static_cast<unsigned char>(1 + random() % 254);
+        for (std::size_t offset = 0; offset < spans; ++offset) {
+          Require(!used[first + offset], "Allocation overlaps a live block");
+          used[first + offset] = true;
+          static_cast<unsigned char*>(pointer)[offset * kSpanBytes] = tag;
+        }
+        live.push_back({pointer, spans, tag});
+      }
+    }
+    CheckFreeRuns(used);
+  }
+
+  // Validate allocations still live at the end as well as those freed during the run.
+  for (const LiveAllocation allocation : live) {
+    for (std::size_t offset = 0; offset < allocation.spans; ++offset) {
+      Require(static_cast<unsigned char*>(allocation.pointer)[offset * kSpanBytes] == allocation.tag,
+              "Final live payload was overwritten");
+    }
+    lua::ArenaFree(allocation.pointer);
+  }
+  void* const whole = lua::ArenaAllocate(kTestSpans * kSpanBytes);
+  Require(whole != nullptr && FirstSpan(whole) == 0, "Whole-arena reuse failed");
+  lua::ArenaFree(whole);
+  std::puts("PASS: 100000 randomized operations; free-run coverage, overlap, payload and final reuse");
+}
diff --git a/tests/memory/LuaArenaReuseTests.cpp b/tests/memory/LuaArenaReuseTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d1b73b28260721f41e7c51f2a1c8c32ef9f1fb49
--- /dev/null
+++ b/tests/memory/LuaArenaReuseTests.cpp
@@ -0,0 +1,164 @@
+// Standalone x64 allocator tests. Each process limits usable arena capacity to 64 spans.
+// Run bash tools/test-lua-arena-reuse.sh; optionally set SANITIZER=undefined or SANITIZER=thread.
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+#include <limits>
+#include <thread>
+#include <vector>
+
+#include "../../src/lua/LuaArena.cpp"
+
+namespace
+{
+  bool failHostNew = false;
+
+  void Require(bool condition)
+  {
+    if (!condition) {
+      std::abort();
+    }
+  }
+
+  void FullCapacity()
+  {
+    std::vector<void*> blocks(gReserveBytes / 16);
+    void* const entireArena = lua::ArenaAllocate(gReserveBytes);
+    Require(entireArena != nullptr);
+    lua::ArenaFree(entireArena);
+
+    failHostNew = true;
+    for (std::size_t index = 0; index < blocks.size(); ++index) {
+      blocks[index] = lua::ArenaAllocate(16);
+      Require(blocks[index] != nullptr);
+      std::memset(blocks[index], static_cast<int>(index % 251), 16);
+    }
+    Require(lua::ArenaAllocate(16) == nullptr);
+    Require(lua::ArenaAllocate(32768) == nullptr);
+    for (std::size_t index = 0; index < blocks.size(); ++index) {
+      Require(static_cast<unsigned char*>(blocks[index])[0] == index % 251);
+      lua::ArenaFree(blocks[index]);
+    }
+    failHostNew = false;
+    std::puts("PASS: all 64 large-free spans reused as 16-byte blocks without host allocation");
+  }
+
+  void MixedSizes()
+  {
+    void* const entireArena = lua::ArenaAllocate(gReserveBytes);
+    Require(entireArena != nullptr);
+    lua::ArenaFree(entireArena);
+
+    void* const small = lua::ArenaAllocate(16384);
+    Require(reinterpret_cast<std::uintptr_t>(small) == gBase);
+    std::memset(small, 53, 16384);
+    void* const large = lua::ArenaAllocate(2 * kSpanBytes);
+    Require(reinterpret_cast<std::uintptr_t>(large) == gBase + kSpanBytes);
+    std::memset(large, 97, 2 * kSpanBytes);
+    lua::ArenaFree(large);
+
+    for (unsigned index = 0; index < 3; ++index) {
+      void* const block = lua::ArenaAllocate(16384);
+      Require(block != nullptr);
+      std::memset(block, 42, 16384);
+    }
+    Require(static_cast<char*>(small)[0] == 53);
+    Require(static_cast<char*>(small)[16383] == 53);
+    Require(lua::ArenaAllocate(16384) != nullptr);
+    std::puts("PASS: splitting a free run preserves its remainder and live small payload");
+  }
+
+  void OversizedRejection()
+  {
+    const auto beforeSpan = gNextSpan;
+    const auto beforeRuns = gFreeRunCount;
+    for (std::size_t bytes : {gReserveBytes + 1u, std::numeric_limits<std::size_t>::max(),
+                              std::numeric_limits<std::size_t>::max() - kSpanBytes + 1u}) {
+      Require(lua::ArenaAllocate(bytes) == nullptr);
+    }
+    Require(gNextSpan == beforeSpan && gFreeRunCount == beforeRuns);
+    void* const live = lua::ArenaAllocate(gReserveBytes);
+    Require(live != nullptr);
+    lua::ArenaFree(live);
+    void* const recovered = lua::ArenaAllocate(16384);
+    Require(recovered == live);
+    std::puts("PASS: oversized requests are rejected without zero-run records or lost capacity");
+  }
+
+  void ConcurrentReuse()
+  {
+    std::vector<void*> large;
+    for (unsigned index = 0; index < 64; ++index) {
+      void* const block = lua::ArenaAllocate(32768);
+      Require(block != nullptr);
+      large.push_back(block);
+    }
+    std::atomic<unsigned> finished = 0;
+    std::vector<std::thread> threads;
+    for (unsigned worker = 0; worker < 8; ++worker) {
+      threads.emplace_back([&, worker] {
+        for (unsigned index = worker; index < 64; index += 8) {
+          lua::ArenaFree(large[index]);
+        }
+        ++finished;
+      });
+    }
+    std::vector<void*> small;
+    while (finished < 8) {
+      if (void* const block = lua::ArenaAllocate(16384)) {
+        std::memset(block, 73, 16384);
+        small.push_back(block);
+      }
+    }
+    for (auto& thread : threads) {
+      thread.join();
+    }
+    while (void* const block = lua::ArenaAllocate(16384)) {
+      std::memset(block, 73, 16384);
+      small.push_back(block);
+    }
+    Require(small.size() == 256);
+    for (std::size_t index = 0; index < small.size(); ++index) {
+      Require(static_cast<char*>(small[index])[0] == 73);
+      Require(static_cast<char*>(small[index])[16383] == 73);
+      for (std::size_t other = 0; other < index; ++other) {
+        Require(small[index] != small[other]);
+      }
+    }
+    std::puts("PASS: concurrent large frees and small refills recover exactly 256 blocks");
+  }
+}
+
+void* operator new(std::size_t bytes)
+{
+  if (failHostNew) {
+    throw std::bad_alloc();
+  }
+  if (void* const block = std::malloc(bytes != 0 ? bytes : 1)) {
+    return block;
+  }
+  throw std::bad_alloc();
+}
+
+void operator delete(void* block) noexcept { std::free(block); }
+void operator delete(void* block, std::size_t) noexcept { std::free(block); }
+
+int main(int argc, char** argv)
+{
+  lua::ArenaReserve();
+  gReserveBytes = 64 * kSpanBytes;
+  const char* const mode = argc > 1 ? argv[1] : "full";
+  if (std::strcmp(mode, "full") == 0) {
+    FullCapacity();
+  } else if (std::strcmp(mode, "mixed") == 0) {
+    MixedSizes();
+  } else if (std::strcmp(mode, "oversized") == 0) {
+    OversizedRejection();
+  } else if (std::strcmp(mode, "threads") == 0) {
+    ConcurrentReuse();
+  } else {
+    return 2;
+  }
+}

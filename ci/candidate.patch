+flags=(-std=c++20 -O2 -pthread -I"$root/src")
+case "${SANITIZER:-none}" in
+  none) ;;
+  undefined) flags+=(-O1 -g -fsanitize=undefined -fno-sanitize-recover=all) ;;
+  thread) flags+=(-O1 -g -fsanitize=thread) ;;
